{
  "name": "@sauce/sdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sauce Games browser SDK: leaderboards + analytics for static web games.",
  "main": "./dist/sauce.js",
  "module": "./dist/sauce.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sauce.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^8.0.14"
  }
}
