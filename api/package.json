{
  "name": "sauce-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sauce Games leaderboard + analytics API (Cloudflare Worker + D1).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute sauce_labs --local --file ./schema.sql",
    "db:remote": "wrangler d1 execute sauce_labs --remote --file ./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.78.0"
  }
}
